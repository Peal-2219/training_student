<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="student_email_template" model="mail.template">

        <field name="name">Student Admission Confirmation</field>

        <field name="model_id" ref="training_student.model_training_student"/>

        <field name="subject">🎓 Admission Confirmed – ${object.name}</field>

        <field name="email_from">${user.email or 'noreply@training.com'}</field>

        <field name="email_to">${object.email}</field>

        <field name="body_html" type="html">
<div style="font-family: Arial, sans-serif; background-color: #f4f6f9; padding: 30px 0;">
    <table width="100%" cellpadding="0" cellspacing="0" style="max-width: 600px; margin: 0 auto;">

        <!-- Header -->
        <tr>
            <td style="background-color: #1a6bdb; border-radius: 8px 8px 0 0; padding: 30px; text-align: center;">
                <h1 style="margin: 0; color: #ffffff; font-size: 22px; font-weight: 700; letter-spacing: 0.5px;">
                    🎓 Admission Confirmed
                </h1>
                <p style="margin: 6px 0 0; color: #cce0ff; font-size: 14px;">
                    Training Management System
                </p>
            </td>
        </tr>

        <!-- Body -->
        <tr>
            <td style="background-color: #ffffff; padding: 30px 35px; border: 1px solid #e0e4ea; border-top: none; border-radius: 0 0 8px 8px;">

                <p style="margin: 0 0 16px; font-size: 15px; color: #333;">
                    Dear <strong>${object.name}</strong>,
                </p>

                <p style="margin: 0 0 20px; font-size: 14px; color: #555; line-height: 1.6;">
                    Congratulations! We are pleased to inform you that your admission has been
                    <strong style="color: #1a6bdb;">successfully confirmed</strong>.
                    Please find your admission details below.
                </p>

                <!-- Details Table -->
                <table width="100%" cellpadding="0" cellspacing="0"
                       style="border: 1px solid #e0e4ea; border-radius: 6px; overflow: hidden; font-size: 14px; margin-bottom: 24px;">
                    <tr style="background-color: #f0f4ff;">
                        <td style="padding: 10px 16px; color: #555; font-weight: 600; width: 40%; border-bottom: 1px solid #e0e4ea;">
                            Student Name
                        </td>
                        <td style="padding: 10px 16px; color: #222; border-bottom: 1px solid #e0e4ea;">
                            ${object.name}
                        </td>
                    </tr>
                    <tr>
                        <td style="padding: 10px 16px; color: #555; font-weight: 600; border-bottom: 1px solid #e0e4ea;">
                            Email Address
                        </td>
                        <td style="padding: 10px 16px; color: #222; border-bottom: 1px solid #e0e4ea;">
                            ${object.email}
                        </td>
                    </tr>
                    <tr style="background-color: #f0f4ff;">
                        <td style="padding: 10px 16px; color: #555; font-weight: 600; border-bottom: 1px solid #e0e4ea;">
                            Course
                        </td>
                        <td style="padding: 10px 16px; color: #222; border-bottom: 1px solid #e0e4ea;">
                            ${object.course_id.name or 'N/A'}
                        </td>
                    </tr>
                    <tr>
                        <td style="padding: 10px 16px; color: #555; font-weight: 600;">
                            Admission Date
                        </td>
                        <td style="padding: 10px 16px; color: #222;">
                            ${object.admission_date or 'N/A'}
                        </td>
                    </tr>
                </table>

                <p style="margin: 0 0 8px; font-size: 14px; color: #555; line-height: 1.6;">
                    If you have any questions or need further assistance, feel free to reach out to us.
                </p>

                <p style="margin: 20px 0 0; font-size: 14px; color: #333;">
                    Best Regards,<br/>
                    <strong>Training Team</strong>
                </p>

            </td>
        </tr>

        <!-- Footer -->
        <tr>
            <td style="padding: 16px; text-align: center;">
                <p style="margin: 0; font-size: 11px; color: #aaa;">
                    This is an automated email. Please do not reply directly to this message.
                </p>
            </td>
        </tr>

    </table>
</div>
        </field>

    </record>

</odoo>