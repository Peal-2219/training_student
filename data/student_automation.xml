<?xml version="1.0" encoding="UTF-8"?>
<odoo>
<data noupdate="1">

    <!-- SERVER ACTION -->
    <record id="action_server_student_confirmation_email" model="ir.actions.server">
        <field name="name">Send Student Confirmation Email</field>

        <field name="model_id" ref="training_student.model_training_student"/>

        <field name="state">code</field>

        <field name="code">
template = env.ref('training_student.student_email_template')

if record.email:
    template.send_mail(record.id, force_send=True)

    msg = "Confirmation Email sent successfully to %s" % record.email
    record.message_post(body=msg)
        </field>
    </record>


    <!-- AUTOMATION -->
    <record id="automation_student_confirmation_email" model="base.automation">
        <field name="name">Student Confirmation Email</field>

        <field name="model_id" ref="training_student.model_training_student"/>

        <field name="trigger">on_write</field>

        <field name="filter_domain">[('state','=','confirmed')]</field>

        <field name="active" eval="True"/>

        <field name="action_server_ids"
               eval="[(4, ref('training_student.action_server_student_confirmation_email'))]"/>

    </record>

</data>
</odoo>