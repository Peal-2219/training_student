<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="cron_auto_update_student_state" model="ir.cron">
        <field name="name">Auto Update Student State</field>

        <!-- Model -->
        <field name="model_id" ref="training_student.model_training_student"/>

        <!-- Python Code -->
        <field name="state">code</field>
        <field name="code">model.cron_auto_update_student_state()</field>

        <!-- Run every 1 day -->
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>

        <!-- Run as Administrator -->
        <field name="user_id" ref="base.user_root"/>

        <!-- Enable Cron -->
        <field name="active" eval="True"/>
    </record>

</odoo>