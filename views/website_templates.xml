<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Partial Template for a single student row -->
    <template id="student_row_partial" name="Student Row Partial">
        <tr>
            <td>
                <span t-esc="student.name" />
            </td>
            <td>
                <span t-esc="student.email" />
            </td>
            <td>
                <span t-esc="student.student_age" />
            </td>
            <td>
                <t t-if="student.course_id">
                    <span t-esc="student.course_id.name" class="badge badge-info" />
                </t>
                <t t-else="">
                    <span class="text-muted">No Course Assigned</span>
                </t>
            </td>
            <td>
                <t t-if="student.state == 'Draft'">
                    <span class="badge badge-secondary"><t t-esc="student.state" /></span>
                </t>
                <t t-elif="student.state == 'Approved'">
                    <span class="badge badge-success"><t t-esc="student.state" /></span>
                </t>
                <t t-elif="student.state == 'Cancelled'">
                    <span class="badge badge-danger"><t t-esc="student.state" /></span>
                </t>
                <t t-else="">
                    <span class="badge badge-primary"><t t-esc="student.state" /></span>
                </t>
            </td>
        </tr>
    </template>

    <template id="student_website_page" name="Student List">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty">
                <!-- Top Snippet Placeholder -->
                <div class="oe_structure oe_empty" id="oe_structure_training_student_top"/>

                <section class="s_text_block pt40 pb40 o_colored_level" data-snippet="s_text_block">
                    <div class="container s_allow_columns">
                        <div class="row">
                            <div class="col-lg-12">
                                <h1 class="text-center">Training Students</h1>
                                <p class="text-center text-muted">A simple page demonstrating QWeb tags</p>
                                
                                <t t-if="not students">
                                    <div class="alert alert-info text-center" role="alert">
                                        No students found.
                                    </div>
                                </t>
                                <t t-if="students">
                                    <table class="table table-striped table-hover mt-4">
                                        <thead class="thead-dark">
                                            <tr>
                                                <th>Name</th>
                                                <th>Email</th>
                                                <th>Age</th>
                                                <th>Course</th>
                                                <th>Status</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="students" t-as="student">
                                                <!-- Call the partial template for each student -->
                                                <t t-call="training_student.student_row_partial"/>
                                            </t>
                                        </tbody>
                                    </table>
                                </t>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Bottom Snippet Placeholder -->
                <div class="oe_structure oe_empty" id="oe_structure_training_student_bottom">
                    <section class="s_text_block pt40 pb40 o_colored_level" data-snippet="s_text_block">
                        <div class="container">
                            <h3 class="text-center text-muted">Drag and drop blocks here</h3>
                        </div>
                    </section>
                </div>
            </div>
        </t>
    </template>
</odoo>