<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ================= COURSE LIST ================= -->
    <record id="view_training_course_list" model="ir.ui.view">
        <field name="name">training.course.list</field>
        <field name="model">training.course</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="duration"/>
                <field name="fees"/>
                <field name="student_count"/>
                <field name="is_available"/>
            </list>
        </field>
    </record>

    <!-- ================= COURSE FORM ================= -->
    <record id="view_training_course_form" model="ir.ui.view">
        <field name="name">training.course.form</field>
        <field name="model">training.course</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="duration"/>
                        <field name="fees"/>
                        <field name="start_date"/>
                        <field name="is_available"/>
                        <field name="student_count" readonly="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ================= 🧩 COURSE KANBAN ================= -->
    <record id="view_training_course_kanban" model="ir.ui.view">
        <field name="name">training.course.kanban</field>
        <field name="model">training.course</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_small_column">
                <!-- Fields used in kanban -->
                <field name="name"/>
                <field name="student_count"/>
                <field name="is_available"/>
                <field name="duration"/>
                <field name="fees"/>

                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card shadow-sm rounded p-3">

                            <!-- HEADER -->
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <strong class="text-primary fs-5">
                                    <i class="fa fa-book me-1"/>
                                    <field name="name"/>
                                </strong>
                            </div>

                            <!-- STUDENT COUNT -->
                            <div class="mb-2">
                                <i class="fa fa-users text-secondary me-1"/>
                                <span class="fw-semibold">Students:</span>
                                <span class="badge bg-info ms-1">
                                    <field name="student_count"/>
                                </span>
                            </div>

                            <!-- COURSE INFO -->
                            <div class="mb-2 text-muted small">
                                <div>
                                    <i class="fa fa-clock-o me-1"/>
                                    Duration:
                                    <span class="fw-semibold">
                                        <field name="duration"/>
                                        days
                                    </span>
                                </div>
                                <div>
                                    <i class="fa fa-money me-1"/>
                                    Fees:
                                    <span class="fw-semibold">
                                        ₹
                                        <field name="fees"/>
                                    </span>
                                </div>
                            </div>

                            <!-- STATUS -->
                            <div class="mt-2">
                                <span t-if="record.is_available.raw_value"
                                      class="badge bg-success">
                                    Available
                                </span>
                                <span t-else="1"
                                      class="badge bg-danger">
                                    Closed
                                </span>
                            </div>

                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <!-- ================= ACTION ================= -->
    <record id="action_training_course" model="ir.actions.act_window">
        <field name="name">Courses</field>
        <field name="res_model">training.course</field>
        <field name="view_mode">kanban,list,form</field>
    </record>
    <menuitem id="menu_training_course"
              name="Courses"
              parent="menu_training_root"
              action="action_training_course"
              sequence="30"/>
</odoo>