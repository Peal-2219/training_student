<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ================================================= -->
    <!-- STUDENT LIST VIEW -->
    <!-- ================================================= -->
    <record id="view_training_student_list" model="ir.ui.view">
        <field name="name">training.student.list</field>
        <field name="model">training.student</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="email"/>
                <field name="student_age"/>
                <field name="course_id"/>
                <field name="state"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- ================================================= -->
    <!-- STUDENT FORM VIEW -->
    <!-- ================================================= -->
    <record id="view_training_student_form" model="ir.ui.view">
        <field name="name">training.student.form</field>
        <field name="model">training.student</field>
        <field name="arch" type="xml">
            <form>

                <header>

                    <button name="action_confirm"
                            string="Confirm"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>

                    <button name="action_approve"
                            string="Approve"
                            type="object"
                            class="btn-success"
                            invisible="state != 'confirmed'"/>

                    <button name="action_cancel"
                            string="Cancel"
                            type="object"
                            class="btn-danger"
                            invisible="state == 'cancelled'"/>

                    <button name="action_reset_draft"
                            string="Reset to Draft"
                            type="object"
                            invisible="state != 'cancelled'"/>

                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,confirmed,approved,cancelled"/>

                </header>

                <sheet>

                    <group>
                        <field name="name"/>
                        <field name="email"/>
                        <field name="dob"/>
                        <field name="student_age" readonly="1"/>
                        <field name="admission_date"/>
                        <field name="user_id"/>
                        <field name="active"/>

                        <field name="course_id"
                               groups="training_student.group_training_manager"/>
                    </group>

                    <notebook>
                        <page string="Enrollments">
                            <field name="enrollment_ids" readonly="1">
                                <list>
                                    <field name="enrollment_number"/>
                                    <field name="course_id"/>
                                    <field name="enrollment_date"/>
                                    <field name="status"/>
                                </list>
                            </field>
                        </page>
                    </notebook>

                </sheet>

                <chatter>
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </chatter>

            </form>
        </field>
    </record>

    <!-- ================================================= -->
    <!-- SEARCH VIEW -->
    <!-- ================================================= -->
    <record id="view_training_student_search" model="ir.ui.view">
        <field name="name">training.student.search</field>
        <field name="model">training.student</field>
        <field name="arch" type="xml">
            <search string="Search Students">

                <field name="name"/>
                <field name="email"/>
                <field name="course_id"/>
                <field name="user_id"/>

                <filter name="filter_draft"
                        string="Draft"
                        domain="[('state','=','draft')]"/>

                <filter name="filter_confirmed"
                        string="Confirmed"
                        domain="[('state','=','confirmed')]"/>

                <filter name="filter_alumni"
                        string="Approved"
                        domain="[('state','=','approved')]"/>
                <separator/>

                <filter name="filter_active"
                        string="Active"
                        domain="[('active','=',True)]"/>

                <filter name="filter_inactive"
                        string="Inactive"
                        domain="[('active','=',False)]"/>

                <group expand="1" string="Group By">
                    <filter name="group_state"
                            string="Status"
                            context="{'group_by':'state'}"/>

                    <filter name="group_course"
                            string="Course"
                            context="{'group_by':'course_id'}"/>

                    <filter name="group_user"
                            string="Assigned User"
                            context="{'group_by':'user_id'}"/>
                </group>

            </search>
        </field>
    </record>

    <!-- ================================================= -->
    <!-- GRAPH VIEW -->
    <!-- ================================================= -->
    <record id="view_training_student_graph" model="ir.ui.view">
        <field name="name">training.student.graph</field>
        <field name="model">training.student</field>
        <field name="arch" type="xml">
            <graph string="Students by Status" type="bar">
                <field name="state" type="row"/>
                <field name="student_age" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- ================================================= -->
    <!-- CALENDAR VIEW -->
    <!-- ================================================= -->
    <record id="view_training_student_calendar" model="ir.ui.view">
        <field name="name">training.student.calendar</field>
        <field name="model">training.student</field>
        <field name="arch" type="xml">
            <calendar string="Students Birthdays"
                      date_start="dob"
                      color="course_id">

                <field name="name"/>
                <field name="course_id"/>
                <field name="student_age"/>

            </calendar>
        </field>
    </record>

    <!-- ================================================= -->
    <!-- ACTION -->
    <!-- ================================================= -->
    <record id="action_training_student" model="ir.actions.act_window">
        <field name="name">Students</field>
        <field name="res_model">training.student</field>
        <field name="view_mode">list,calendar,form,graph</field>
        <field name="search_view_id" ref="view_training_student_search"/>
    </record>

    <!-- ================================================= -->
    <!-- MENU -->
    <!-- ================================================= -->
    <menuitem id="menu_training_root"
              name="Training"
              sequence="10"/>

    <menuitem id="menu_training_student"
              name="Students"
              parent="menu_training_root"
              action="action_training_student"
              sequence="20"/>

</odoo>