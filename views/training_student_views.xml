<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- STUDENT LIST -->
    <record id="view_training_student_list" model="ir.ui.view">
        <field name="name">training.student.list</field>
        <field name="model">training.student</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="email"/>
                <field name="student_age"/>
                <field name="state"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- STUDENT FORM -->
    <record id="view_training_student_form" model="ir.ui.view">
        <field name="name">training.student.form</field>
        <field name="model">training.student</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="email"/>
                        <field name="dob"/>
                        <field name="student_age" readonly="1"/>
                        <field name="admission_date"/>
                        <field name="user_id"/>
                        <field name="active"/>
                        <field name="course_id"
                               groups="training_student.group_training_manager"/>
                    </group>

                    <notebook>
                        <page string="Enrollments">
                            <field name="enrollment_ids" readonly="1">
                                <list>
                                    <field name="enrollment_number"/>
                                    <field name="course_id"/>
                                    <field name="enrollment_date"/>
                                    <field name="status"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>

                <chatter>
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </chatter>
            </form>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_training_student" model="ir.actions.act_window">
        <field name="name">Students</field>
        <field name="res_model">training.student</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- MENU -->
    <menuitem id="menu_training_root"
              name="Training"
              sequence="10"/>

    <menuitem id="menu_training_student"
              name="Students"
              parent="menu_training_root"
              action="action_training_student"
              sequence="20"/>

</odoo>