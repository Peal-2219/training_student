<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- LIST VIEW -->
    <record id="view_training_enrollment_list" model="ir.ui.view">
        <field name="name">training.enrollment.list</field>
        <field name="model">training.enrollment</field>
        <field name="arch" type="xml">
            <list>
                <field name="enrollment_number"/>
                <field name="student_id"/>
                <field name="course_id"/>
                <field name="enrollment_date"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_training_enrollment_form" model="ir.ui.view">
        <field name="name">training.enrollment.form</field>
        <field name="model">training.enrollment</field>
        <field name="arch" type="xml">
            <form>

                <!-- ✅ ONLY ONE STATUSBAR -->
                <header>
                    <field name="status"
                           widget="statusbar" options="{'clickable': '1'}"
                           statusbar_visible="draft,confirmed,cancelled"/>
                </header>

                <sheet>
                    <group>
                        <field name="enrollment_number" readonly="1"/>
                        <field name="student_id"/>
                        <field name="course_id"/>
                        <field name="enrollment_date"/>
                    </group>
                </sheet>

                <chatter>
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </chatter>

            </form>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_training_enrollment" model="ir.actions.act_window">
        <field name="name">Enrollments</field>
        <field name="res_model">training.enrollment</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- MENU -->
    <menuitem id="menu_training_enrollment"
              name="Enrollments"
              parent="menu_training_root"
              action="action_training_enrollment"
              sequence="40"/>

</odoo>