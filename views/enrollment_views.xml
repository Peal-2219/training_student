<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- SEQUENCE -->
    <record id="seq_training_enrollment" model="ir.sequence">
        <field name="name">Enrollment Sequence</field>
        <field name="code">training.enrollment</field>
        <field name="prefix">ENR/</field>
        <field name="padding">4</field>
    </record>

    <!-- ENROLLMENT LIST -->
    <record id="view_training_enrollment_list" model="ir.ui.view">
        <field name="name">training.enrollment.list</field>
        <field name="model">training.enrollment</field>
        <field name="arch" type="xml">
            <list>
                <field name="enrollment_number"/>
                <field name="student_id"/>
                <field name="course_id"/>
                <field name="enrollment_date"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <!-- ENROLLMENT FORM -->
    <record id="view_training_enrollment_form" model="ir.ui.view">
        <field name="name">training.enrollment.form</field>
        <field name="model">training.enrollment</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="enrollment_number" />
                        <field name="student_id"/>
                        <field name="course_id"/>
                        <field name="enrollment_date"/>
                        <field name="status"/>
                    </group>
                </sheet>

                <chatter>
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </chatter>
            </form>
        </field>
    </record>

    <record id="action_training_enrollment" model="ir.actions.act_window">
        <field name="name">Enrollments</field>
        <field name="res_model">training.enrollment</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_training_enrollment"
              name="Enrollments"
              parent="menu_training_root"
              action="action_training_enrollment"
              sequence="40"/>

</odoo>