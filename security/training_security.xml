<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Module Category -->
    <record id="module_category_training" model="ir.module.category">
        <field name="name">Training</field>
        <field name="sequence">30</field>
    </record>

    <!-- Training User -->
    <record id="group_training_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="training_student.module_category_training"/>
    </record>

    <!-- Training Manager -->
    <record id="group_training_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="training_student.module_category_training"/>
        <field name="implied_ids" eval="[(4, ref('group_training_user'))]"/>
    </record>

    <!-- Record Rule: User sees only their students -->
    <record id="rule_training_student_user" model="ir.rule">
        <field name="name">Training Student: Own Records</field>
        <field name="model_id" ref="model_training_student"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_training_user'))]"/>
    </record>

    <!-- Manager sees all -->
    <record id="rule_training_student_manager" model="ir.rule">
        <field name="name">Training Student: Manager Full Access</field>
        <field name="model_id" ref="model_training_student"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('group_training_manager'))]"/>
    </record>

</odoo>