<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Module Category -->
    <record id="module_category_training" model="ir.module.category">
        <field name="name">Training</field>
        <field name="sequence">30</field>
    </record>

    <!-- Training User -->
    <record id="group_training_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="training_student.module_category_training"/>
    </record>

    <!-- Training Manager -->
    <record id="group_training_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="training_student.module_category_training"/>
        <field name="implied_ids" eval="[(4, ref('training_student.group_training_user'))]"/>
    </record>

        <!-- USER: Can only READ Courses -->
    <record id="rule_course_user_readonly" model="ir.rule">
        <field name="name">Course User Read Only</field>
        <field name="model_id" ref="model_training_course"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('training_student.group_training_user'))]"/>
    </record>

    <!-- USER: Can only READ Enrollments -->
    <record id="rule_enrollment_user_readonly" model="ir.rule">
        <field name="name">Enrollment User Read Only</field>
        <field name="model_id" ref="model_training_enrollment"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('training_student.group_training_user'))]"/>
    </record>

</odoo>